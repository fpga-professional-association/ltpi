[tasks]
tx_bmc    tx bmc
tx_prove  tx prove
tx_cover  tx cover
rx_bmc    rx bmc
rx_prove  rx prove
rx_cover  rx cover

[options]
bmc:   mode bmc
bmc:   depth 30
prove: mode prove
prove: depth 15
cover: mode cover
cover: depth 40

[engines]
smtbmc bitwuzla

[script]
read -formal -sv ltpi_pkg.sv ltpi_phy.sv
tx: prep -top ltpi_phy_tx
rx: prep -top ltpi_phy_rx

[files]
../rtl/ltpi_pkg.sv
../rtl/ltpi_phy.sv
