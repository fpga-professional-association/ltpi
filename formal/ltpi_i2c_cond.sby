[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 40
prove: mode prove
prove: depth 25
cover: mode cover
cover: depth 40

[engines]
smtbmc bitwuzla

[script]
read -formal -sv ltpi_pkg.sv ltpi_i2c_cond.sv
# Small filter window keeps traces shallow; F1 is parameter-independent.
chparam -set CLK_HZ 100000000 ltpi_i2c_cond
prep -top ltpi_i2c_cond

[files]
../rtl/ltpi_pkg.sv
../rtl/ltpi_i2c_cond.sv
