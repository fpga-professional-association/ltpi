[tasks]
pri_bmc     pri bmc
pri_prove   pri prove
pri_cover   pri cover
sec_bmc     sec bmc
sec_prove   sec prove
sec_cover   sec cover

[options]
bmc:   mode bmc
bmc:   depth 30
prove: mode prove
prove: depth 15
cover: mode cover
cover: depth 60

[engines]
smtbmc bitwuzla

[script]
read -formal -sv ltpi_pkg.sv ltpi_i2c_relay.sv
# pri = arbitration-winning side (SCM), sec = deferring side (HPM)
sec: chparam -set ARB_PRIORITY 0 ltpi_i2c_relay
prep -top ltpi_i2c_relay

[files]
../rtl/ltpi_pkg.sv
../rtl/ltpi_i2c_relay.sv
