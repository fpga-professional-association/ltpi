[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 30
prove: mode prove
prove: depth 15
cover: mode cover
cover: depth 300

[engines]
smtbmc bitwuzla

[script]
read -formal -sv ltpi_pkg.sv ltpi_gpio_channel.sv
# 40 NL GPIOs -> 3 slices, last one partial (8 bits) - exercises masking.
chparam -set NL_TOTAL 40 ltpi_gpio_channel
prep -top ltpi_gpio_channel

[files]
../rtl/ltpi_pkg.sv
../rtl/ltpi_gpio_channel.sv
